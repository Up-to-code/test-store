<div class="min-h-52 w-full px-5 my-4">
    <salla-swiper
      id="main-slider-{{ position }}"
      auto-play
      slider-config='{{ sliderConfig }}'
      slider-options='{{ sliderOptions }}'
      slider-items='{{ sliderItems }}'
      slider-classes='{{ sliderClasses }}'
    >
  
    {% for slide in component.slider2 %}
      <div class="swiper-slide mx-2 w-full min-h-[300px] lg:min-h-[528px] bg-gradient-to-r from-[#2F3C44] via-dark to-[#2F5351] rounded flex items-center justify-center">
        <img class="w-[50%] object-contain rounded max-w-[500px]" src="{{ slide.image }}" alt="{{ slide.title }}" />
        <div>
         <p class="text-end text-zinc-300 text-4xl font-medium max-w-[300px] px-4">
           {{ slide.title }}
         </p>
         <p class="text-white text-4xl font-medium max-w-[300px] px-4">
           {{ slide.title_build }}
         </p>
        </div>
      </div>
    {% endfor %}
    
    </salla-swiper>
  </div>
  